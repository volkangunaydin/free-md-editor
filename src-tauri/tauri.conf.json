{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Free MD Editor",
  "version": "0.1.0",
  "identifier": "io.github.volkangunaydin.freemdeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Free MD Editor",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost https: http:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Volkan Günaydın",
    "copyright": "Copyright © 2026 Volkan Günaydın. MIT License.",
    "category": "Productivity",
    "shortDescription": "Free, open-source Markdown editor",
    "longDescription": "Free MD Editor is a lightweight, open-source Markdown editor for Windows with a WYSIWYG mode and a Monaco-based source mode. Double-click any .md file to open it.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdwn"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish", "French", "German"],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
